module clock_bcd_basico
(
    input clk,
    input reset,
    input pause,
    output [3:0] min_u, // Unidades minuto
    output [3:0] min_t, // Decenas minuto
    output [3:0] hr_u,  // Unidades hora
    output [3:0] hr_t   // Decenas hora
);

// Arreglo para los 4 displays BCD
reg [3:0] bcd [0:3]; 

// Variables internas
reg [31:0] clk_divider;
reg [5:0] sec; 

// Conexión a salidas físicas
assign min_u = bcd[0];
assign min_t = bcd[1];
assign hr_u  = bcd[2];
assign hr_t  = bcd[3];

// --- BANDERAS (Dataflow) ---
wire tick_1hz   = (clk_divider == 32'd49999999);
wire tick_1min  = (tick_1hz   && sec == 6'b111011);      // 59
wire tick_10min = (tick_1min  && bcd[0] == 4'b1001);     // 9
wire tick_1hr   = (tick_10min && bcd[1] == 4'b0101);     // 5

// --- DIVISOR Y SEGUNDOS ---
always @(posedge clk or posedge reset) begin
    if (reset) begin
        clk_divider <= 32'd0;       
        sec         <= 6'b000000;   
    end else if (!pause) begin
        
        // Si el divisor llega a su límite de 1 segundo
        if (tick_1hz) begin
            clk_divider <= 32'd0; // Reiniciamos el divisor
            
            // Lógica de segundos con if/else sencillo
            if (sec == 6'b111011) begin
                sec <= 6'b000000;     // Si llega a 59, regresa a 0
            end else begin
                sec <= sec + 6'b000001; // Si no, suma 1
            end
            
        end else begin
            // Si aún no pasa 1 segundo, el divisor sigue contando
            clk_divider <= clk_divider + 32'd1; 
        end
        
    end
end

// --- CONTROL DE MINUTOS Y HORAS ---
always @(posedge clk or posedge reset) begin
    if (reset) begin
        bcd[0] <= 4'b0000;
        bcd[1] <= 4'b0000;
        bcd[2] <= 4'b0000;
        bcd[3] <= 4'b0000;
    end else if (!pause) begin
        
        // --- Unidades de Minuto ---
        if (tick_1min) begin
            if (bcd[0] == 4'b1001) begin
                bcd[0] <= 4'b0000;      // Si llega a 9, regresa a 0
            end else begin
                bcd[0] <= bcd[0] + 4'b0001; // Si no, suma 1
            end
        end
        
        // --- Decenas de Minuto ---
        if (tick_10min) begin
            if (bcd[1] == 4'b0101) begin
                bcd[1] <= 4'b0000;      // Si llega a 5, regresa a 0
            end else begin
                bcd[1] <= bcd[1] + 4'b0001; // Si no, suma 1
            end
        end
        
        // --- Horas (Unidades y Decenas) ---
        if (tick_1hr) begin
            // Si son las 11 (1 en decenas y 1 en unidades), regresamos a 00
            if (bcd[3] == 4'b0001 && bcd[2] == 4'b0001) begin
                bcd[2] <= 4'b0000;
                bcd[3] <= 4'b0000;
            end 
            // Si la unidad de hora llega a 9, pasa a 0 y la decena suma 1
            else if (bcd[2] == 4'b1001) begin
                bcd[2] <= 4'b0000;
                bcd[3] <= bcd[3] + 4'b0001;
            end 
            // Si no pasa nada de lo anterior, la unidad suma 1 normal
            else begin
                bcd[2] <= bcd[2] + 4'b0001;
            end
        end

    end
end

endmodule
