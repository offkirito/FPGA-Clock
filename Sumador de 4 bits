module clock_bcd_strict
(
    input clk,
    input reset,
    input pause,
    output [3:0] min_u, // Unidades minuto
    output [3:0] min_t, // Decenas minuto
    output [3:0] hr_u,  // Unidades hora
    output [3:0] hr_t   // Decenas hora
);

// Arreglo para los 4 displays BCD
reg [3:0] bcd [0:3]; 

// Variables internas
reg [31:0] clk_divider;
reg [5:0] sec; 

// Conexión a salidas físicas
assign min_u = bcd[0];
assign min_t = bcd[1];
assign hr_u  = bcd[2];
assign hr_t  = bcd[3];

// --- BANDERAS (Dataflow) ---

// 1. EL DIVISOR: El único usando DECIMAL ('d)
wire tick_1hz   = (clk_divider == 32'd49999999);

// 2. EL RESTO: Estrictamente en BINARIO ('b)
// 6'b111011 es el 59 en binario
wire tick_1min  = (tick_1hz   && sec == 6'b111011);
// 4'b1001 es el 9 en binario
wire tick_10min = (tick_1min  && bcd[0] == 4'b1001); 
// 4'b0101 es el 5 en binario
wire tick_1hr   = (tick_10min && bcd[1] == 4'b0101); 

// --- DIVISOR Y SEGUNDOS ---
always @(posedge clk or posedge reset) begin
    if (reset) begin
        clk_divider <= 32'd0;       // Reset en Decimal
        sec         <= 6'b000000;   // Reset en Binario
    end else if (!pause) begin
        if (tick_1hz) begin
            clk_divider <= 32'd0;   // Decimal
            
            // Condición en binario (Si llega a 59, regresa a 0, sino suma 1)
            sec <= (sec == 6'b111011) ? 6'b000000 : sec + 6'b000001; 
        end else begin
            clk_divider <= clk_divider + 32'd1; // Suma en Decimal
        end
    end
end

// --- CONTROL DE MINUTOS Y HORAS EN BINARIO PURO ---
always @(posedge clk or posedge reset) begin
    if (reset) begin
        // Reset de todo el arreglo en binario
        bcd[0] <= 4'b0000;
        bcd[1] <= 4'b0000;
        bcd[2] <= 4'b0000;
        bcd[3] <= 4'b0000;
    end else if (!pause) begin
        
        // --- Unidades de Minuto ---
        if (tick_1min) begin
            bcd[0] <= (bcd[0] == 4'b1001) ? 4'b0000 : bcd[0] + 4'b0001;
        end
        
        // --- Decenas de Minuto ---
        if (tick_10min) begin
            bcd[1] <= (bcd[1] == 4'b0101) ? 4'b0000 : bcd[1] + 4'b0001;
        end
        
        // --- Horas (Unidades y Decenas) ---
        if (tick_1hr) begin
            // Si son las 11 en binario (0001 y 0001)
            if (bcd[3] == 4'b0001 && bcd[2] == 4'b0001) begin
                bcd[2] <= 4'b0000;
                bcd[3] <= 4'b0000;
            end 
            // Si las unidades de hora llegan a 9 (1001)
            else if (bcd[2] == 4'b1001) begin
                bcd[2] <= 4'b0000;
                bcd[3] <= bcd[3] + 4'b0001;
            end 
            // Suma normal de hora
            else begin
                bcd[2] <= bcd[2] + 4'b0001;
            end
        end

    end
end

endmodule
